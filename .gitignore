# ---------------------------------------------------------------
# Industrial IoT Sensor Analytics Platform - .gitignore
# ---------------------------------------------------------------

# ---- Data (too large / regenerated by the pipeline) ----
# Keep the folder structure (.gitkeep) but never commit data files.
data/*/*
!data/*/.gitkeep

# ---- Trained models & generated artefacts ----
models/*
!models/.gitkeep
logs/
mlruns/

# ---- Secrets & credentials ----
.env
.env.*
kaggle.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Tools & caches ----
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ---- Editors & OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
